rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // كل مدرّس يقدر يقرأ ويكتب في بياناته الخاصة فقط
    match /users/{userId}/storage/{key} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // مساحة اختيارية للبيانات المشتركة بين كل المستخدمين المسجّلين (غير مستخدَمة حاليًا)
    match /shared_storage/{key} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
